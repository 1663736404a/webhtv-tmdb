+static int64_t android_monotonic_time_ns(void)
+{
+    struct timespec ts;
+    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0)
+        return 0;
+    if (ts.tv_sec < 0 || ts.tv_sec > INT64_MAX / MP_TIME_S_TO_NS(1))
+        return 0;
+    return (int64_t)ts.tv_sec * MP_TIME_S_TO_NS(1) + ts.tv_nsec;
+}
+
+static void disable_timed_release(struct vo *vo, int64_t elapsed,
+                                  int64_t budget, const char *reason)
+{
+    struct priv *p = vo->priv;
+    if (p->timed_release_disabled)
+        return;
+
+    p->timed_release_disabled = true;
+    p->slow_timed_release_streak = 0;
+    p->queue_offset = 0;
+    vo_set_queue_params(vo, 0, 1, 2);
+    MP_WARN(vo, "MediaCodec timed release disabled for this playback: "
+                "reason=%s elapsed=%lldus budget=%lldus; "
+                "using MPV immediate output.\n",
+            reason, (long long)(elapsed / 1000),
+            (long long)(budget / 1000));
+}
+
+static void update_queue_offset(struct vo *vo, int64_t duration)
+{
+    struct priv *p = vo->priv;
+    if (p->timed_release_disabled || duration <= 0)
+        return;
+
+    int64_t offset = MPMIN(duration, MAX_TIMED_RELEASE_LEAD_NS);
+    if (offset < MIN_TIMED_RELEASE_LEAD_NS)
+        offset = 0;
+    int64_t difference = p->queue_offset > offset
+        ? p->queue_offset - offset : offset - p->queue_offset;
+    if (p->queue_offset > 0 && difference < MP_TIME_US_TO_NS(250))
+        return;
+
+    p->queue_offset = offset;
+    vo_set_queue_params(vo, offset, 1, 2);
+}
