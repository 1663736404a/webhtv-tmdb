+static void *get_image_side_data(const struct mp_image *mpi,
+                                 enum AVFrameSideDataType type)
+{
+    for (int i = 0; i < mpi->num_ff_side_data; i++) {
+        if (mpi->ff_side_data[i].type == type)
+            return mpi->ff_side_data[i].buf->data;
+    }
+    return NULL;
+}
+
+static void apply_dovi_profile7_hdr10_fallback(vd_ffmpeg_ctx *ctx,
+                                               struct mp_image *mpi)
+{
+    if (!mpi || !ctx->codec || ctx->codec->dv_profile != 7 ||
+        ctx->opts->dovi_profile7_mode != DOVI_PROFILE7_HDR10)
+        return;
+
+    // Keep the original access units for the vendor HEVC decoder. Profile 7
+    // has an independently decodable HDR10 base layer, and removing EL/RPU
+    // NALs before MediaCodec has proven less compatible than letting the
+    // decoder ignore them. Strip Dolby Vision only from the decoded frame.
+    mp_image_params_restore_dovi_mapping(&mpi->params);
+    mpi->params.color.hdr = (struct pl_hdr_metadata){0};
+    pl_map_hdr_metadata(&mpi->params.color.hdr, &(struct pl_av_hdr_metadata) {
+        .mdm = get_image_side_data(
+            mpi, AV_FRAME_DATA_MASTERING_DISPLAY_METADATA),
+        .clm = get_image_side_data(
+            mpi, AV_FRAME_DATA_CONTENT_LIGHT_LEVEL),
+        .dhp = get_image_side_data(mpi, AV_FRAME_DATA_DYNAMIC_HDR_PLUS),
+    });
+    mpi->params.repr.dovi = NULL;
+    mpi->params.no_dovi = true;
+    mpi->params.no_enhancement_layer = true;
+    av_buffer_unref(&mpi->dovi);
+    mp_image_unrefp(&mpi->enhancement_layer);
+
+    for (int i = 0; i < mpi->num_ff_side_data;) {
+        int type = mpi->ff_side_data[i].type;
+        if (type != AV_FRAME_DATA_DOVI_METADATA &&
+            type != AV_FRAME_DATA_DOVI_RPU_BUFFER) {
+            i++;
+            continue;
+        }
+        av_buffer_unref(&mpi->ff_side_data[i].buf);
+        MP_TARRAY_REMOVE_AT(mpi->ff_side_data, mpi->num_ff_side_data, i);
+    }
+
+    if (!ctx->dovi_profile7_hdr10_notified) {
+        MP_INFO(ctx, "DV7 HDR10 fallback: preserving decoder input and "
+                     "stripping Dolby Vision frame metadata.\n");
+        ctx->dovi_profile7_hdr10_notified = true;
+    }
+}
+
 static int send_packet(struct mp_filter *vd, struct demux_packet *pkt)
 {
     vd_ffmpeg_ctx *ctx = vd->priv;
