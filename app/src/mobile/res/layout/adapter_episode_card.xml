<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_episode_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="124dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/still"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/detail_episode"
            android:scaleType="centerCrop"
            android:src="@drawable/artwork"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.WebHTV.EpisodeStill" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mark"
            style="@style/Video.ContextText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="6dp"
            android:background="@drawable/shape_episode_mark"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="看到 27:37"
            tools:visibility="visible" />

    </FrameLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/date"
        style="@style/Video.ContextText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:singleLine="true"
        android:textColor="@color/white_60"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="2026-07-14"
        tools:visibility="visible" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/number"
        style="@style/Video.ContextText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:singleLine="true"
        android:textColor="@color/white_80"
        android:textSize="12sp"
        tools:text="第 1 集 · 48 分钟" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text"
        style="@style/Video.ContextText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/selector_video_text"
        android:textSize="14sp"
        tools:text="脚踏实地" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/overview"
        style="@style/Video.ContextText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="2"
        android:textColor="@color/white_60"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="经历拉斯维加斯狂野之夜后，幸儿一觉醒来。"
        tools:visibility="visible" />

</androidx.appcompat.widget.LinearLayoutCompat>
